# AI Mechanical 3DCAD Design Agent public configuration template
# Every setting is optional until you intentionally enable its capability.
# Modern workspace/bootstrap (recommended)
# macOS/Linux: MECH_DESIGN_WORKSPACE=/path/to/mechanical-design-workspace
# Windows: MECH_DESIGN_WORKSPACE=C:\path\to\mechanical-design-workspace
# Recommended ordinary-design MCP exposure profile
# MECH_DESIGN_MCP_TOOL_PROFILE=design
# Local PostgreSQL/pgvector service and runtime capability
# Copy these settings into an explicitly selected, access-protected env file.
# The placeholders below are intentionally nonfunctional and must be replaced.
# MECH_DESIGN_POSTGRES_USER=mechanical_design
# MECH_DESIGN_POSTGRES_DB=mechanical_design
# MECH_DESIGN_POSTGRES_PASSWORD=<replace-with-postgresql-password>
# MECH_DESIGN_POSTGRES_PORT=55432
# Use a URL-encoded form of the raw PostgreSQL password in the database URL.
# MECH_DESIGN_DATABASE_URL=postgresql://mechanical_design:<url-encoded-postgresql-password>@127.0.0.1:55432/mechanical_design
# Local Neo4j Community service and runtime capability
# MECH_DESIGN_NEO4J_USER=neo4j
# MECH_DESIGN_NEO4J_PASSWORD=<replace-with-neo4j-password>
# MECH_DESIGN_NEO4J_BOLT_PORT=57687
# MECH_DESIGN_NEO4J_URI=bolt://127.0.0.1:57687
# Optional headless FreeCAD
# MECH_DESIGN_FREECADCMD=/absolute/path/to/FreeCADCmd
# Legacy compatibility (not the recommended bootstrap flow)
# MECH_DESIGN_ENV_FILE=/absolute/path/to/explicit.env
# MECH_DESIGN_ACTOR_ID=example-user
# Copy examples/product_families/example-family.json into the workspace first.
# Relative family paths resolve only against an explicit workspace.
# MECH_DESIGN_FAMILY_CONFIG=config/product_families/example-family.json
