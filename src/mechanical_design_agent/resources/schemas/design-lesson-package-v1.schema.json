{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-lesson-package-v1.schema.json",
  "title": "Design Lesson Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lesson_id",
    "title",
    "codex_session_id",
    "source",
    "problem",
    "root_causes",
    "corrections",
    "prevention",
    "applicability",
    "non_applicable_conditions",
    "search_terms",
    "atomic_assertions",
    "evidence_manifest"
  ],
  "$defs": {
    "nonblankString": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "stringList": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonblankString"}
    },
    "conditionExpression": {
      "oneOf": [
        {"$ref": "#/$defs/nonblankString"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all_of"],
          "properties": {
            "all_of": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/conditionExpression"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any_of"],
          "properties": {
            "any_of": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/conditionExpression"}
            }
          }
        }
      ]
    }
  },
  "properties": {
    "schema_version": {"const": "DesignLessonPackage/v1"},
    "lesson_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "title": {"$ref": "#/$defs/nonblankString"},
    "codex_session_id": {"$ref": "#/$defs/nonblankString"},
    "source": {
      "type": "object",
      "required": [
        "organization_id",
        "design_group_id",
        "working_copy_id",
        "change_set_ids",
        "before_model_sha256",
        "after_model_sha256"
      ],
      "properties": {
        "organization_id": {"$ref": "#/$defs/nonblankString"},
        "design_group_id": {"$ref": "#/$defs/nonblankString"},
        "family_id": {"type": ["string", "null"]},
        "working_copy_id": {"$ref": "#/$defs/nonblankString"},
        "change_set_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonblankString"}
        },
        "before_model_sha256": {"$ref": "#/$defs/sha256"},
        "after_model_sha256": {"$ref": "#/$defs/sha256"},
        "source_scope_note": {"type": "string"}
      }
    },
    "problem": {
      "type": "object",
      "required": [
        "discovery_stage",
        "severity",
        "symptoms",
        "affected_components",
        "affected_interfaces",
        "failure_modes"
      ],
      "properties": {
        "summary": {"type": "string"},
        "discovery_stage": {"$ref": "#/$defs/nonblankString"},
        "severity": {"$ref": "#/$defs/nonblankString"},
        "symptoms": {"$ref": "#/$defs/stringList"},
        "affected_components": {"$ref": "#/$defs/stringList"},
        "affected_interfaces": {"$ref": "#/$defs/stringList"},
        "failure_modes": {"$ref": "#/$defs/stringList"}
      }
    },
    "root_causes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonblankString"}
    },
    "corrections": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonblankString"}
    },
    "prevention": {
      "type": "object",
      "required": [
        "required_checks",
        "design_review_questions",
        "workflow_gate",
        "detection_method"
      ],
      "properties": {
        "required_checks": {"$ref": "#/$defs/stringList"},
        "design_review_questions": {"$ref": "#/$defs/stringList"},
        "workflow_gate": {"$ref": "#/$defs/nonblankString"},
        "detection_method": {"$ref": "#/$defs/nonblankString"}
      }
    },
    "applicability": {
      "type": "object",
      "required": [
        "component_classes",
        "interface_types",
        "design_stages",
        "required_conditions"
      ],
      "properties": {
        "component_classes": {"$ref": "#/$defs/stringList"},
        "interface_types": {"$ref": "#/$defs/stringList"},
        "design_stages": {"$ref": "#/$defs/stringList"},
        "required_conditions": {"$ref": "#/$defs/stringList"},
        "required_condition_expression": {"$ref": "#/$defs/conditionExpression"}
      }
    },
    "non_applicable_conditions": {"$ref": "#/$defs/stringList"},
    "search_terms": {"$ref": "#/$defs/stringList"},
    "atomic_assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "assertion_key",
          "subject_ref",
          "predicate",
          "object_value",
          "constraint_kind",
          "evidence_refs"
        ],
        "properties": {
          "assertion_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "subject_ref": {"$ref": "#/$defs/nonblankString"},
          "predicate": {"$ref": "#/$defs/nonblankString"},
          "object_value": {},
          "unit": {"type": ["string", "null"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "constraint_kind": {"enum": ["check", "warning", "preference", "hard_constraint"]},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/nonblankString"}
          },
          "contradicts": {"$ref": "#/$defs/stringList"}
        }
      }
    },
    "evidence_manifest": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": ["role"],
        "properties": {"role": {"const": "geometry_validation"}}
      },
      "minContains": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "path", "role", "media_type", "sha256"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "path": {"$ref": "#/$defs/nonblankString"},
          "role": {
            "enum": [
              "source_before_model",
              "source_after_model",
              "geometry_validation",
              "assembly_completeness_validation",
              "fastener_interface_validation",
              "mechanical_interface_validation",
              "review_image",
              "supporting_report"
            ]
          },
          "media_type": {"$ref": "#/$defs/nonblankString"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "working_copy_id": {"$ref": "#/$defs/nonblankString"},
          "change_set_id": {"$ref": "#/$defs/nonblankString"},
          "model_sha256": {"$ref": "#/$defs/sha256"},
          "validation_kind": {
            "enum": [
              "geometry_model",
              "assembly_completeness",
              "fastener_interfaces",
              "mechanical_interfaces"
            ]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"role": {"const": "geometry_validation"}}, "required": ["role"]},
            "then": {
              "required": ["working_copy_id", "change_set_id", "model_sha256", "validation_kind"],
              "properties": {"validation_kind": {"const": "geometry_model"}}
            }
          },
          {
            "if": {"properties": {"role": {"const": "assembly_completeness_validation"}}, "required": ["role"]},
            "then": {
              "required": ["working_copy_id", "change_set_id", "model_sha256", "validation_kind"],
              "properties": {"validation_kind": {"const": "assembly_completeness"}}
            }
          },
          {
            "if": {"properties": {"role": {"const": "fastener_interface_validation"}}, "required": ["role"]},
            "then": {
              "required": ["working_copy_id", "change_set_id", "model_sha256", "validation_kind"],
              "properties": {"validation_kind": {"const": "fastener_interfaces"}}
            }
          },
          {
            "if": {"properties": {"role": {"const": "mechanical_interface_validation"}}, "required": ["role"]},
            "then": {
              "required": ["working_copy_id", "change_set_id", "model_sha256", "validation_kind"],
              "properties": {"validation_kind": {"const": "mechanical_interfaces"}}
            }
          }
        ]
      }
    }
  }
}
