{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mechanical-design:analysis:preview-receipt:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "AnalysisPreviewReceipt/v1"
    },
    "status": {
      "enum": [
        "completed",
        "failed"
      ]
    },
    "operator": {
      "const": "assistant"
    },
    "design_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "analysis_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "geometry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "regions_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "visible_region_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\:\\x00]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "relative_path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    }
  },
  "required": [
    "schema_version",
    "status",
    "operator",
    "design_id",
    "analysis_id",
    "spec_sha256",
    "source_sha256",
    "geometry_sha256",
    "regions_sha256",
    "runtime_manifest_sha256",
    "visible_region_ids",
    "images"
  ],
  "additionalProperties": false
}
