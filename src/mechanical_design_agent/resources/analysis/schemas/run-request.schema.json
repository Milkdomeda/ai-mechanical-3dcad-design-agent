{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mechanical-design:analysis:run-request:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "AnalysisRunRequest/v1"
    },
    "design_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "analysis_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision_ref": {
      "type": "object",
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\:\\x00]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "relative_path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "spec_ref": {
      "type": "object",
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\:\\x00]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "relative_path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "approval_ref": {
      "type": "object",
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\:\\x00]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "relative_path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "source_binding_ref": {
      "type": "object",
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\:\\x00]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "relative_path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "tool_bindings_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "organization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "design_group_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "requested_family_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "organization_id",
        "design_group_id",
        "requested_family_id"
      ],
      "additionalProperties": false
    },
    "idempotency_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fingerprint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "retry_run_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "executor_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "executor_identity_ref": {
      "type": "object",
      "properties": {
        "relative_path": {
          "const": "executor.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "relative_path",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "design_id",
    "analysis_id",
    "run_id",
    "spec_sha256",
    "revision_ref",
    "spec_ref",
    "approval_ref",
    "source_binding_ref",
    "tool_bindings_sha256",
    "policy_sha256",
    "runtime_manifest_sha256",
    "scope",
    "idempotency_sha256",
    "fingerprint_sha256",
    "retry_run_id",
    "created_at"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "executor_sha256": [
      "executor_identity_ref"
    ],
    "executor_identity_ref": [
      "executor_sha256"
    ]
  }
}
