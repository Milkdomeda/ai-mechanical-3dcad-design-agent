{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mechanical-design:analysis:source-binding:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "AnalysisSourceBinding/v1"
    },
    "source": {
      "type": "object",
      "properties": {
        "origin_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "origin_sha256": {
          "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/sha256"
        },
        "origin_identity": {
          "type": "object",
          "properties": {
            "volume": {
              "type": "integer",
              "minimum": 0
            },
            "file_index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "volume",
            "file_index"
          ],
          "additionalProperties": false
        },
        "design_model_sha256": {
          "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/sha256"
        },
        "design_model_identity": {
          "type": "object",
          "properties": {
            "volume": {
              "type": "integer",
              "minimum": 0
            },
            "file_index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "volume",
            "file_index"
          ],
          "additionalProperties": false
        },
        "design_state_sha256": {
          "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/sha256"
        },
        "cad_model_classification": {
          "enum": [
            "existing_model",
            "new_design"
          ]
        },
        "snapshot_ref": {
          "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/artifact"
        }
      },
      "required": [
        "origin_path",
        "origin_sha256",
        "origin_identity",
        "design_model_sha256",
        "design_model_identity",
        "design_state_sha256",
        "cad_model_classification",
        "snapshot_ref"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "source"
  ],
  "additionalProperties": false
}
