{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mechanical-design:analysis:manifest:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "AnalysisManifest/v1"
    },
    "design_id": {
      "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/id"
    },
    "analysis_id": {
      "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/id"
    },
    "run_id": {
      "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/id"
    },
    "spec_sha256": {
      "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/sha256"
    },
    "status": {
      "const": "complete"
    },
    "delivery_version": {
      "type": "integer",
      "minimum": 1
    },
    "artifacts": {
      "type": "object",
      "minProperties": 6,
      "maxProperties": 10000,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "additionalProperties": {
        "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/sha256"
      }
    },
    "dependencies": {
      "type": "object",
      "maxProperties": 10000,
      "additionalProperties": {
        "type": "array",
        "maxItems": 10000,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "case_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/id"
      }
    },
    "result_ref": {
      "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/artifact"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "design_id",
    "analysis_id",
    "run_id",
    "spec_sha256",
    "status",
    "delivery_version",
    "artifacts",
    "dependencies",
    "case_ids",
    "result_ref",
    "created_at"
  ],
  "additionalProperties": false
}
