{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mechanical-design:analysis:approval:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "AnalysisApproval/v1"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "decision_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "approval_state": {
      "const": "APPROVE"
    },
    "reviewed_spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_binding_ref": {
      "type": "object",
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\:\\x00]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "relative_path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "geometry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "regions_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "material_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tool_bindings_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "summary_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preview_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "knowledge_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "actor_id",
    "decision_text",
    "approval_state",
    "reviewed_spec_sha256",
    "spec_sha256",
    "source_binding_ref",
    "geometry_sha256",
    "regions_sha256",
    "material_sha256",
    "policy_sha256",
    "tool_bindings_sha256",
    "summary_sha256",
    "preview_receipt_sha256",
    "knowledge_receipt_sha256",
    "approved_at"
  ],
  "additionalProperties": false
}
