{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mechanical-design:analysis:completion:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "AnalysisCompletion/v1"
    },
    "design_id": {
      "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/id"
    },
    "analysis_id": {
      "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/id"
    },
    "run_id": {
      "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/id"
    },
    "spec_sha256": {
      "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/sha256"
    },
    "status": {
      "const": "complete"
    },
    "manifest_ref": {
      "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/artifact"
    },
    "result_ref": {
      "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/artifact"
    },
    "delivery_version": {
      "type": "integer",
      "minimum": 1
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "design_id",
    "analysis_id",
    "run_id",
    "spec_sha256",
    "status",
    "manifest_ref",
    "result_ref",
    "delivery_version",
    "completed_at"
  ],
  "additionalProperties": false
}
