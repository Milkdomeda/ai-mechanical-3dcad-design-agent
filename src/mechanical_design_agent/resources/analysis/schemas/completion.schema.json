{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mechanical-design:analysis:completion:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "AnalysisCompletion/v1"
    },
    "design_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "analysis_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "status": {
      "enum": [
        "complete"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "design_id",
    "analysis_id",
    "status",
    "run_id",
    "spec_sha256"
  ],
  "additionalProperties": false
}
