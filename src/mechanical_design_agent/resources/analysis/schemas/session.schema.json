{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mechanical-design:analysis:session:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "AnalysisSession/v1"
    },
    "design_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "analysis_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "queued",
        "running",
        "needs_input",
        "needs_attention",
        "completed",
        "cancelled",
        "ready_for_review",
        "awaiting_visual_review"
      ]
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "type": "object",
      "properties": {
        "origin_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "origin_sha256": {
          "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/sha256"
        },
        "origin_identity": {
          "type": "object",
          "properties": {
            "volume": {
              "type": "integer",
              "minimum": 0
            },
            "file_index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "volume",
            "file_index"
          ],
          "additionalProperties": false
        },
        "design_model_sha256": {
          "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/sha256"
        },
        "design_model_identity": {
          "type": "object",
          "properties": {
            "volume": {
              "type": "integer",
              "minimum": 0
            },
            "file_index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "volume",
            "file_index"
          ],
          "additionalProperties": false
        },
        "design_state_sha256": {
          "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/sha256"
        },
        "cad_model_classification": {
          "enum": [
            "existing_model",
            "new_design"
          ]
        },
        "snapshot_ref": {
          "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/artifact"
        }
      },
      "required": [
        "origin_path",
        "origin_sha256",
        "origin_identity",
        "design_model_sha256",
        "design_model_identity",
        "design_state_sha256",
        "cad_model_classification",
        "snapshot_ref"
      ],
      "additionalProperties": false
    },
    "spec_revision": {
      "type": "integer",
      "minimum": 0
    },
    "active_run_id": {
      "anyOf": [
        {
          "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "latest_delivery": {
      "anyOf": [
        {
          "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "accepted_delivery": {
      "anyOf": [
        {
          "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "current_revision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "relative_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\:\\x00]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "relative_path",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "approval": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "relative_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\:\\x00]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "relative_path",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "latest_run_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "acceptance_ref": {
      "anyOf": [
        {
          "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "design_id",
    "analysis_id",
    "status",
    "state_revision",
    "source",
    "spec_revision",
    "active_run_id",
    "latest_delivery",
    "accepted_delivery",
    "created_at",
    "updated_at",
    "current_revision",
    "approval",
    "latest_run_id"
  ],
  "additionalProperties": false
}
