{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mechanical-design:analysis:session:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "AnalysisSession/v1"
    },
    "design_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "analysis_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "queued",
        "running",
        "needs_input",
        "needs_attention",
        "completed",
        "cancelled"
      ]
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "design_id",
    "analysis_id",
    "status",
    "state_revision"
  ],
  "additionalProperties": false
}
