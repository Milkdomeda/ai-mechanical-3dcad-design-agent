{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mechanical-design:analysis:run:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "AnalysisRun/v1"
    },
    "design_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "analysis_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "status": {
      "enum": [
        "queued",
        "preparing",
        "meshing",
        "solving",
        "validating",
        "awaiting_visual_review",
        "completed",
        "failed",
        "cancelled",
        "timed_out",
        "interrupted"
      ]
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_ref": {
      "type": "object",
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\:\\x00]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "relative_path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0
    },
    "worker": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "worker_uuid": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "pid": {
              "type": "integer",
              "minimum": 1
            },
            "created_ns": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "worker_uuid",
            "pid",
            "created_ns"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "cancel_requested": {
      "type": "boolean"
    },
    "cancel_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "numerical_status": {
      "enum": [
        "not_evaluated",
        "passed",
        "failed",
        "inconclusive"
      ]
    },
    "criteria_status": {
      "enum": [
        "not_evaluated",
        "passed",
        "failed",
        "inconclusive"
      ]
    },
    "applicability_status": {
      "enum": [
        "not_evaluated",
        "within_declared_scope",
        "limited_screening",
        "outside_scope"
      ]
    },
    "completion_ref": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "relative_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\:\\x00]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "relative_path",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostic": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "stage": {
            "enum": [
              "queued",
              "preparing",
              "meshing",
              "solving",
              "validating",
              "awaiting_visual_review",
              "completed",
              "failed",
              "cancelled",
              "timed_out",
              "interrupted"
            ]
          },
          "code": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "attempt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        },
        "required": [
          "sequence",
          "at",
          "stage",
          "code",
          "message",
          "attempt"
        ],
        "additionalProperties": false
      },
      "maxItems": 512
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "attempt_ref": {
      "anyOf": [
        {
          "$ref": "urn:mechanical-design:analysis:common:v1#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "design_id",
    "analysis_id",
    "run_id",
    "status",
    "spec_sha256",
    "request_ref",
    "state_revision",
    "worker",
    "cancel_requested",
    "cancel_reason",
    "attempt",
    "numerical_status",
    "criteria_status",
    "applicability_status",
    "completion_ref",
    "diagnostic",
    "events",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "completion_ref": {
            "type": "object",
            "properties": {
              "relative_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\:\\x00]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "relative_path",
              "sha256"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
