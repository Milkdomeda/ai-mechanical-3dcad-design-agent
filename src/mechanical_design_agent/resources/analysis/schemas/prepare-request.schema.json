                        "kg/m^3",
                        "g/cm^3",
                        "mm/s^2",
                        "m/s^2",
                        "N*mm",
                        "N*m",
                        "J",
                        "1"
                      ]
                    }
                  },
                  "required": [
                    "value",
                    "unit"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "value",
