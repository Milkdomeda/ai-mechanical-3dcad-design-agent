      "const": "AnalysisPrepareRequest/v1"
    },
    "source_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "expected_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "draft_spec": {
      "$ref": "urn:mechanical-design:analysis:spec:v1"
    },
    "region_selectors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "region_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "object_name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "surface_type": {
