{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mechanical-design:analysis:knowledge-receipt:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "AnalysisKnowledgeReceipt/v1"
    },
    "design_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "analysis_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "scope": {
      "type": "object",
      "properties": {
        "organization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "design_group_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "requested_family_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "organization_id",
        "design_group_id",
        "requested_family_id"
      ],
      "additionalProperties": false
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "features_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "completed_matches",
        "completed_no_match",
        "unavailable"
      ]
    },
    "blocking": {
      "type": "boolean"
    },
    "available_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "uniqueItems": true,
      "maxItems": 5000
    },
    "required_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "uniqueItems": true,
      "maxItems": 5000
    },
    "missing_required_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "uniqueItems": true,
      "maxItems": 5000
    },
    "warning_code": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "design_id",
    "analysis_id",
    "source_sha256",
    "actor_id",
    "scope",
    "query",
    "features_sha256",
    "context_sha256",
    "status",
    "blocking",
    "available_ids",
    "required_ids",
    "missing_required_ids",
    "warning_code",
    "retrieved_at"
  ],
  "additionalProperties": false
}
